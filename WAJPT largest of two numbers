class Largest {
    void find() {
        int a = 15, b = 25;

        if (a > b)
            System.out.println("Largest = " + a);
        else
            System.out.println("Largest = " + b);
    }

    public static void main(String[] args) {
        Largest obj = new Largest();
        obj.find();
    }
}
