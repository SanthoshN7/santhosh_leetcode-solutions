class EvenOdd {
    void check() {
        int n = 7;

        if (n % 2 == 0)
            System.out.println("Even Number");
        else
            System.out.println("Odd Number");
    }

    public static void main(String[] args) {
        EvenOdd obj = new EvenOdd();
        obj.check();
    }
}
