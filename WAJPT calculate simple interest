class SimpleInterest {
    void calculate() {
        double p = 1000, r = 5, t = 2;
        double si = (p * r * t) / 100;

        System.out.println("Simple Interest = " + si);
    }

    public static void main(String[] args) {
        SimpleInterest obj = new SimpleInterest();
        obj.calculate();
    }
}
